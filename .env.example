# VAR HR environment template
# Copy the relevant values into Replit Secrets / Environment Variables.
# Never commit real credentials to the repository.

# Optional external PostgreSQL override. When present, this takes precedence
# over Replit's managed DATABASE_URL. Keep real values in Replit Secrets.
EXTERNAL_DATABASE_URL=

# Required when EXTERNAL_DATABASE_URL points to Aiven. Paste the Aiven CA PEM
# certificate here only in Replit Secrets; TLS verification remains enabled.
AIVEN_CA_CERT=

# Replit provides DATABASE_URL automatically for its managed PostgreSQL.
DATABASE_URL=postgresql://user:password@localhost:5432/var_hr

# Reserved for future key management and must be stored as a secret if enabled.
# The current implementation uses database-backed random session tokens and does
# not read SESSION_SECRET yet.
SESSION_SECRET=replace-with-a-long-random-value

# API server. Artifact workflows provide PORT automatically.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Vite artifact workflows provide BASE_PATH automatically.
# Use "/" for the main web artifact and "/__mockup" for the mockup sandbox.
BASE_PATH=/

# In production, set this explicitly to true only during the controlled
# first-founder bootstrap. The endpoint is also limited to the period before
# a Platform Owner exists.
VAR_HR_ENABLE_INITIAL_PROVISIONING=false

# Keep disabled in production. When false, ADMS requests must provide the
# configured device registration key.
ZKTECO_ADMS_ALLOW_UNAUTHENTICATED=false

# Phase 2 Web Push. Generate once with:
# pnpm --filter @workspace/api-server exec web-push generate-vapid-keys
# Store the private key only in Replit Secrets or an ignored local .env file.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=