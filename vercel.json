{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/artifacts/api-server/src/app.ts"
    },
    {
      "source": "/iclock/:path*",
      "destination": "/artifacts/api-server/src/app.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/artifacts/var-hr/$1"
    }
  ]
}
