{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate:dev": "node ./scripts/migration-control.mjs migrate:dev",
    "inspect:dev": "node ./scripts/migration-control.mjs inspect:dev",
    "inspect:aiven": "node ./scripts/migration-control.mjs inspect:aiven",
    "baseline:dev": "node ./scripts/migration-control.mjs baseline:dev",
    "baseline:aiven": "node ./scripts/migration-control.mjs baseline:aiven",
    "migrate:aiven": "node ./scripts/migration-control.mjs migrate:aiven"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
